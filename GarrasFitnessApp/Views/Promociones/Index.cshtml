@model IEnumerable<GarrasFitnessApp.Models.Promocion>
@{
    ViewData["Title"] = "Promociones Activas";
    var hoy = DateTime.Today;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Promociones Activas</h2>
        <a asp-action="Create" class="btn btn-link text-decoration-none">+ Nueva Promoción</a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Descuento</th>
                    <th>Vigencia</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No hay promociones registradas.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        bool esActiva = item.FechaInicio.Date <= hoy && item.FechaFin.Date >= hoy;
                        <tr>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td>Bs. @item.Descuento.ToString("F2")</td>
                            <td>@item.FechaInicio.ToString("dd/MM/yyyy") – @item.FechaFin.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (esActiva)
                                {
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 rounded-pill px-3">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25 rounded-pill px-3">Inactiva</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">Editar</a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar esta promoción?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>