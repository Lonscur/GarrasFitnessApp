@{
    ViewData["Title"] = "Nueva Promoción";
}

<div class="container py-4" style="background-color: var(--bg-light, #F8FAFC); min-height: 85vh;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-garras p-0">
                <div class="card-header border-0 pt-4 pb-0 bg-transparent text-center">
                    <h3 class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: var(--primary, #111827);">
                        Nueva Promoción
                    </h3>
                    <p class="text-muted small">Crear una oferta de descuento para los planes de membresía</p>
                </div>
                <div class="card-body p-4">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="d-flex align-items-start gap-2 mb-3 p-3 rounded-3"
                             style="background-color: #FEF2F2; border: 1px solid #FCA5A5; color: #B91C1C; font-size: 0.9rem;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0; margin-top:2px;">
                                <circle cx="12" cy="12" r="10" stroke="#B91C1C" stroke-width="2" />
                                <path d="M12 8v5" stroke="#B91C1C" stroke-width="2" stroke-linecap="round" />
                                <circle cx="12" cy="16" r="1" fill="#B91C1C" />
                            </svg>
                            <div>@Html.ValidationSummary(true, "")</div>
                        </div>
                    }

                    <div id="alertaPromoCliente" class="d-none align-items-start gap-2 mb-3 p-3 rounded-3"
                         style="background-color: #FEF2F2; border: 1px solid #FCA5A5; color: #B91C1C; font-size: 0.9rem;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0; margin-top:2px;">
                            <circle cx="12" cy="12" r="10" stroke="#B91C1C" stroke-width="2" />
                            <path d="M12 8v5" stroke="#B91C1C" stroke-width="2" stroke-linecap="round" />
                            <circle cx="12" cy="16" r="1" fill="#B91C1C" />
                        </svg>
                        <div>Completa el nombre, el descuento y un rango de fechas válido.</div>
                    </div>

                    <form id="formPromocion" asp-controller="Promociones" asp-action="Create" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="color: var(--primary, #111827);">Nombre de la Promoción</label>
                            <input type="text" name="Nombre" id="Nombre" class="form-control" placeholder="Ej. Promo Verano" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="color: var(--primary, #111827);">Descripción</label>
                            <textarea name="Descripcion" id="Descripcion" class="form-control" rows="2" placeholder="Ej. Descuento por inicio de temporada"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="color: var(--primary, #111827);">Porcentaje de Descuento (%)</label>
                            <input type="number" name="PorcentajeDescuento" id="PorcentajeDescuento" class="form-control" min="1" max="100" placeholder="Ej. 15" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold" style="color: var(--primary, #111827);">Fecha de Inicio</label>
                                <input type="date" name="FechaInicio" id="FechaInicio" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold" style="color: var(--primary, #111827);">Fecha de Fin</label>
                                <input type="date" name="FechaFin" id="FechaFin" class="form-control" required />
                            </div>
                        </div>

                        <div class="form-check mb-4">
                            <input type="checkbox" name="Activa" id="Activa" class="form-check-input" checked />
                            <label class="form-check-label" for="Activa">Activar promoción inmediatamente</label>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn-garras">Guardar Promoción</button>
                            <a asp-controller="Promociones" asp-action="Index" class="btn btn-outline-secondary py-2 rounded-3">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('formPromocion').addEventListener('submit', function (e) {
            const nombre = document.getElementById('Nombre').value.trim();
            const descuento = parseFloat(document.getElementById('PorcentajeDescuento').value);
            const inicio = document.getElementById('FechaInicio').value;
            const fin = document.getElementById('FechaFin').value;
            const alerta = document.getElementById('alertaPromoCliente');

            const descuentoValido = !isNaN(descuento) && descuento > 0 && descuento <= 100;
            const fechasValidas = inicio && fin && new Date(fin) >= new Date(inicio);

            if (!nombre || !descuentoValido || !fechasValidas) {
                e.preventDefault();
                alerta.classList.remove('d-none');
                alerta.classList.add('d-flex');
                alerta.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else {
                alerta.classList.add('d-none');
                alerta.classList.remove('d-flex');
            }
        });
    </script>
}
