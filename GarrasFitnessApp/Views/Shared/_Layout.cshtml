@using System.Security.Claims

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Garras Fitness Club</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GarrasFitnessApp.styles.css" asp-append-version="true" />

    <!-- 👇 Íconos de Bootstrap (necesario para los bi bi-*) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;900&display=swap"
          rel="stylesheet" />
</head>

<body>

 
    <header>
        <nav class="navbar navbar-expand-sm navbar-light mb-3"
             style="background-color: #FFD9B3 !important; border-bottom: 2px solid #F97316;">

            <div class="container-fluid">

                <a class="navbar-brand d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                   
                    <img src="~/img/logo-garras.png"
                         alt="Garras Fitness Club"
                         style="height: 48px; width: auto; display: block;"
                         onerror="this.style.display='none'; document.getElementById('fallback-logo').classList.remove('d-none');" />

          
                    <span id="fallback-logo"
                          class="d-none align-items-center gap-2">

                        <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                              style="width: 34px; height: 34px; background-color: #111827;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M4 9v6M2 10v4M22 10v4M20 9v6M7 8v8M17 8v8M7 12h10"
                                      stroke="#F97316"
                                      stroke-width="2"
                                      stroke-linecap="round"
                                      stroke-linejoin="round" />
                            </svg>
                        </span>

                        <span class="fw-bold"
                              style="font-family: 'Montserrat', sans-serif; color: #111827;">
                            GARRAS
                            <span style="color: #F97316;">FITNESS</span>
                            CLUB
                        </span>
                    </span>

                </a>

          
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

      
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1 gap-1">

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               style="color: #111827;"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               style="color: #111827;"
                               asp-area=""
                               asp-controller="Acceso"
                               asp-action="Index">
                                Acceso
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               style="color: #111827;"
                               asp-area=""
                               asp-controller="Socios"
                               asp-action="Create">
                                Socios
                            </a>
                        </li>

                        <!-- 👇 Promociones visible para todos -->
                        <li class="nav-item">
                            <a class="nav-link fw-semibold"
                               style="color: #111827;"
                               asp-area=""
                               asp-controller="Promociones"
                               asp-action="Index">
                                Promociones
                            </a>
                        </li>

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link fw-semibold dropdown-toggle"
                                   style="color: #111827;"
                                   href="#"
                                   id="adminDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Administración
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="Caja"
                                           asp-action="Index">
                                            Caja
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area=""
                                           asp-controller="Cobranzas"
                                           asp-action="Index">
                                            Cobranzas
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                     
                        @if (User.IsInRole("Socio"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold"
                                   style="color: #111827;"
                                   asp-area=""
                                   asp-controller="PortalSocio"
                                   asp-action="Index">
                                    Mi Portal
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="fw-semibold" style="color: #111827;">
                                    @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-area=""
                                      asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-link nav-link fw-bold p-0"
                                            style="color: #F97316;">
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold"
                                   style="color: #F97316;"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>
        </nav>
    </header>

 
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="border-top footer text-muted py-3"
            style="background-color: #F8FAFC;">

        <div class="container d-flex justify-content-between flex-wrap">

            <span>
                &copy; @DateTime.Now.Year Garras Fitness Club &bull; Cochabamba
            </span>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy"
               style="color: #F97316;">
                Privacidad
            </a>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>