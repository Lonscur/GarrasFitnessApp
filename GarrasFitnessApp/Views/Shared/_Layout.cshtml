<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Garras Fitness Club</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GarrasFitnessApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light border-bottom mb-3" style="background-color: #FFFFFF;">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                          style="width: 34px; height: 34px; background-color: var(--primary, #111827);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4 9v6M2 10v4M22 10v4M20 9v6M7 8v8M17 8v8M7 12h10" stroke="#F97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span class="fw-bold" style="font-family: 'Montserrat', sans-serif; color: var(--primary, #111827);">
                        GARRAS <span style="color: var(--accent, #F97316);">FITNESS</span> CLUB
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 gap-1">
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" style="color: var(--primary, #111827);" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" style="color: var(--primary, #111827);" asp-area="" asp-controller="Acceso" asp-action="Index">Acceso</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-semibold" style="color: var(--primary, #111827);" asp-area="" asp-controller="Socios" asp-action="Create">Socios</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link fw-bold" style="color: var(--accent, #F97316);" asp-area="" asp-controller="Account" asp-action="Login">Cerrar sesión</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3" style="background-color: var(--bg-light, #F8FAFC);">
        <div class="container d-flex justify-content-between flex-wrap">
            <span>&copy; @DateTime.Now.Year Garras Fitness Club &bull; Cochabamba</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: var(--accent, #F97316);">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>