@{
    ViewData["Title"] = "Panel Administrador - Caja";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Panel Administrador - Control de Caja</h2>
            <p class="text-muted mb-0">Gestión de ingresos, pagos y transacciones del día.</p>
        </div>
        <a href="#" class="btn btn-outline-primary">
            <i class="bi bi-printer"></i> Imprimir Reporte PDF
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Ingresos Totales (Hoy)</h6>
                        <h3 class="mb-0 text-success">Bs. 1,550.00</h3>
                    </div>
                    <i class="bi bi-cash-stack fs-3 text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Membresías Registradas</h6>
                        <h3 class="mb-0 text-primary">12</h3>
                    </div>
                    <i class="bi bi-people fs-3 text-primary"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Estado de Caja</h6>
                        <h3 class="mb-0 text-success">Abierta</h3>
                    </div>
                    <i class="bi bi-unlock fs-3 text-success"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Transacciones Recientes de Caja</h5>
            <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise"></i> Actualizar
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Socio / Concepto</th>
                        <th>Método de Pago</th>
                        <th>Fecha y Hora</th>
                        <th class="text-end">Monto</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Inscripción Mensual - Juan Pérez</td>
                        <td><span class="badge bg-success">Efectivo</span></td>
                        <td>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">Bs. 150.00</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Pago Plan Anual - María Gómez</td>
                        <td><span class="badge bg-info">Transferencia</span></td>
                        <td>@DateTime.Now.AddHours(-1).ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">Bs. 1,400.00</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>